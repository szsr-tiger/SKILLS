  "十九畏": {
    "description": "硫黄原是火中精，朴硝一见便相争；水银莫与砒霜见；狼毒最怕密陀僧；巴豆性烈最为上，偏与牵牛不顺情；丁香莫与郁金见；牙硝难合京三棱；川乌草乌不顺犀；人参最怕五灵脂；官桂善能调冷气，若逢石脂便相欺",
    "rules": [
      {"drug_A": "硫黄", "drug_B": "朴硝", "severity": "中等", "note": "硫黄畏朴硝"},
